extends SceneTree
const Online = preload("res://core/online_ai.gd")
const Identity = preload("res://core/cubot_identity.gd")
var failures := 0
func check(ok: bool, label: String) -> void:
	if not ok:
		failures += 1
		printerr("FAIL: ", label)
func _initialize() -> void:
	var req: Dictionary = Online.make_request("openai", "example-model", "test-key", "system", "hello")
	check(req.get("url") == "https://api.openai.com/v1/chat/completions", "OpenAI only HTTPS")
	check(not str(req.get("body", "")).contains("test-key"), "key not in body")
	check("Authorization: Bearer test-key" in req.get("headers", []), "bearer header")
	var endpoints := {"openai":"https://api.openai.com/v1/chat/completions","groq":"https://api.groq.com/openai/v1/chat/completions","openrouter":"https://openrouter.ai/api/v1/chat/completions","deepseek":"https://api.deepseek.com/chat/completions"}
	for provider in endpoints:
		var cloud: Dictionary = Online.make_request(provider, "example-model", "test-key", "s", "p")
		check(cloud.get("url") == endpoints[provider], "fixed provider endpoint")
		check("Authorization: Bearer test-key" in cloud.get("headers", []), "provider bearer header")
		check(not str(cloud.get("body", "")).contains("test-key"), "key not in cloud body")
	var gemini: Dictionary = Online.make_request("gemini", "gemini-test", "test-key", "s", "p")
	check(gemini.get("url") == "https://generativelanguage.googleapis.com/v1beta/models/gemini-test:generateContent", "Gemini native endpoint")
	check("x-goog-api-key: test-key" in gemini.get("headers", []), "Gemini header")
	check(Online.make_request("gemini", "gemini-test/../evil", "key", "s", "p").is_empty(), "reject path injection")
	check(Online.make_request("https://evil.test", "m", "key", "s", "p").is_empty(), "reject unknown provider")
	for provider in Online.PROVIDERS:
		var listing: Dictionary = Online.models_request(provider, "test-key")
		check(str(listing.get("url", "")).begins_with(str(Online.BASE[provider]) + "/models"), "model listing origin")
	var gemini_models: Dictionary = Online.parse_models("gemini", 0, 200, '{"models":[{"name":"models/gemini-chat","supportedGenerationMethods":["generateContent"]},{"name":"models/embedding","supportedGenerationMethods":["embedContent"]}]}')
	check(gemini_models.get("models", []).size() == 1 and "gemini-chat" in gemini_models.get("models", []), "Gemini generation filter")
	var models: Dictionary = Online.parse_models("groq", 0, 200, '{"data":[{"id":"chat"},{"id":"chat"}]}')
	check(models.get("models", []).size() == 1 and "chat" in models.get("models", []), "deduplicate models")
	var g_reply: Dictionary = Online.parse_response(0, 200, '{"candidates":[{"content":{"parts":[{"thought":true,"text":"hidden"},{"text":"hello"}]}}]}', "gemini")
	check(g_reply.get("text") == "hello", "Gemini visible response only")
	check(not Online.parse_response(0, 429, '{"error":{"code":"insufficient_quota","message":"secret"}}').get("ok", true), "provider quota error")
	check(not str(Online.parse_response(0, 429, '{"error":{"message":"secret"}}')).contains("secret"), "no provider raw error leak")
	check(Online.make_request("openai", "m", "key\r\nInjected: yes", "s", "p").is_empty(), "header injection rejected")
	check(Online.make_request("openai", "", "key", "s", "p").is_empty(), "missing model")
	check(Online.make_request("openai", "m", "", "s", "p").is_empty(), "missing key")
	var good: Dictionary = Online.parse_response(0, 200, '{"choices":[{"message":{"content":"hello"}}]}')
	check(good.get("ok") == true and good.get("text") == "hello", "parse chat")
	check(not Online.parse_response(0, 401, '{"error":"secret"}').get("ok", true), "auth error")
	check(not str(Online.parse_response(0, 401, '{"error":"secret"}')).contains("secret"), "no error body echo")
	check(not Online.parse_response(0, 200, '{"choices":[]}').get("ok", true), "empty result")
	check(not Online.parse_response(0, 200, '{"choices":[{"message":{"content":null}}]}').get("ok", true), "null result")
	check(not Online.parse_response(1, 200, "").get("ok", true), "transport error")
	var atlas := Identity.system_prompt("atlas", ["text"], {})
	var pixel := Identity.system_prompt("pixel", ["png"], {})
	check(atlas.contains("Your name is ATLAS") and atlas.contains("Manager"), "atlas identity")
	check(pixel.contains("Your name is PIXEL") and pixel.contains("Designer"), "pixel identity")
	check(atlas.contains("CUBYTE is the platform, not your name"), "platform distinction")
	for id in ["atlas", "pixel", "mesh"]:
		var identity := Identity.system_prompt(id, ["text"], {})
		check(identity.begins_with("Your name is " + id.to_upper() + "."), "selected Cubot identity")
		check(identity.contains("Identity is background context, not a script to recite."), "implicit identity")
		check(identity.contains("Do not introduce yourself"), "no repeated introductions")
		check(identity.contains("Only identify yourself if the player explicitly asks"), "identity on request")
		check(identity.contains("Answer the player's actual message directly and naturally"), "natural conversation")
		check(identity.contains("Tools require player approval"), "tool approval remains enforced")

	check(Identity.system_prompt("unknown", [], {}).is_empty(), "unknown identity rejected")
	check(not Identity.system_prompt("mesh", [], {}).contains("private-note"), "no private context by default")
	check(Identity.system_prompt("mesh", [], {"memory":"private-note"}).contains("private-note"), "explicit shared context")
	print("CUBYTE online AI tests: ", failures, " failures")
	quit(0 if failures == 0 else 1)
