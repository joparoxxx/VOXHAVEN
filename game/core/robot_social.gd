extends RefCounted
## Local social animation only: these lines are scripted, not generated by an AI.
const IDS := ["atlas", "pixel", "mesh", "nova"]
const LINES := {
	"atlas": ["How is your next task?", "Let's keep our work organized."],
	"pixel": ["Ready to try a new design?", "I'll keep the colors in mind."],
	"mesh": ["Time to check the geometry?", "A solid plan comes first."],
	"nova": ["Shall we review the data?", "Let's check the details."]
}
const REPLIES := {
	"atlas":"One step at a time.",
	"pixel":"Sounds good. Let's get creative!",
	"mesh":"Agreed. Precision matters.",
	"nova":"Good idea. We can verify it."
}
static func heading(from: Vector3, to: Vector3, current: float) -> float:
	var direction := to - from
	direction.y = 0.0
	return current if direction.length_squared() < 0.0001 else atan2(direction.x, direction.z)

static func dialogue(first: String, second: String) -> Array[String]:
	var lines: Array[String] = []
	if first == second or first not in IDS or second not in IDS:
		return lines
	lines.append(LINES[first][0])
	lines.append(REPLIES[second])
	lines.append(LINES[first][1])
	return lines

static func speaker(turn: int) -> int:
	return turn % 2

static func duration(line: String) -> float:
	return clampf(1.1 + float(line.length()) * 0.065, 2.4, 4.6)
